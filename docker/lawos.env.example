# LAW-OS environment. Copy to docker/lawos.env (git-ignored) and fill in. Never commit real keys.

# --- Origin (spec §2.2): the ONLY URL clients use ---
LAWOS_BASE_URL=https://tayebhomeserver.<TAILNET>.ts.net
LAWOS_PORT=3005
LAWOS_DATA_DIR=/srv/lawos
LAWOS_HIDE_UPSTREAM=true
TZ=Africa/Casablanca
# Spec §12: no analytics. Upstream AnythingLLM telemetry is on by default.
DISABLE_TELEMETRY=true

# --- Single-user password mode (spec §2.3). Generate with: openssl rand -hex 32 ---
AUTH_TOKEN=
JWT_SECRET=
SIG_KEY=
SIG_SALT=

# --- AI (Phase 2+). Leave blank to run with AI disabled. Server-side API keys only (spec §4.4). ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL_MULTIMODAL=
GEMINI_MODEL_FAST=
GEMINI_EMBEDDING_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_REASONING=
AI_MONTHLY_BUDGET_USD_GEMINI=0
AI_MONTHLY_BUDGET_USD_DEEPSEEK=0
# 0 = no AI spend allowed: jobs pause visibly until a budget is set (also editable in Settings).
# Price estimates for the budget gate, USD per 1M tokens. Set them to your models' real prices.
AI_PRICE_GEMINI_INPUT_PER_MTOK=0.3
AI_PRICE_GEMINI_AUDIO_INPUT_PER_MTOK=1.0
AI_PRICE_GEMINI_OUTPUT_PER_MTOK=2.5
AI_PRICE_DEEPSEEK_INPUT_PER_MTOK=0.28
AI_PRICE_DEEPSEEK_OUTPUT_PER_MTOK=0.42

# --- Background worker (one job at a time). Set to "off" to stop AI/ffmpeg processing. ---
LAWOS_WORKER=on

# --- Push (Phase 6) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Study defaults (editable later in Settings) ---
EXAM_LOCKDOWN_DAYS=10
NEW_CARDS_PER_DAY=15

# --- Scrapers (Phase 6) ---
SCRAPER_ENABLED=false

# accounts. Google Sign-In: OAuth client ids from Google Cloud Console (web client first; add the
# Android client's audience if it differs). Empty = no Google button.
GOOGLE_OAUTH_CLIENT_IDS=156344028022-cke3arhqhkqb6uvbrldmu9a217gfvd1i.apps.googleusercontent.com

# email codes (sign-up verification, password reset). Required for students to register.
# Gmail: create an app password (Google account → Security → 2-Step Verification → App passwords).
QANOUNI_GMAIL_USER=
QANOUNI_GMAIL_APP_PASSWORD=
# Or any SMTP server instead:
# QANOUNI_SMTP_HOST=
# QANOUNI_SMTP_PORT=587
# QANOUNI_SMTP_SECURE=false
# QANOUNI_SMTP_USER=
# QANOUNI_SMTP_PASS=
# QANOUNI_MAIL_FROM="Talib <no-reply@example.com>"
# Whether new students may create accounts (the admin can also toggle this in Settings).
# Facebook Login: BOTH are required (the server checks every token against your app). developers.facebook.com
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Complaints / legal support address shown on the portal (a mailbox you read, on your own domain)
QANOUNI_SUPPORT_EMAIL=contact@qanouni.ma
QANOUNI_REGISTRATION_OPEN=true
SCRAPER_MIN_INTERVAL_SECONDS=10
